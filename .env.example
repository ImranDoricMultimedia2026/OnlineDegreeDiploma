# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGO_URI: MongoDB connection string (Optional: auto-uses persistent store if not provided)
MONGO_URI="mongodb://localhost:27017/online_degree_diploma"

# JWT_SECRET: Secret key for signing JWT authentication tokens
JWT_SECRET="online_degree_diploma_super_secret_jwt_key_2026"

# Default Admin Credentials
ADMIN_EMAIL="admin@onlinedegreediploma.com"
ADMIN_PASSWORD="adminpassword123"
